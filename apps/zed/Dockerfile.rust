ARG BASE_IMAGE=ghcr.io/java131313/neko/base-rs:latest
FROM $BASE_IMAGE

#
# Rust-stack variant of the zed app image (Dockerfile.rust): same content
# as the Go-based Dockerfile, but FROM the neko-rs base (no Go server,
# no neko-webshell stanza in the app conf — the base already runs it).
# openbox + CJK/emoji fonts already ship in the base image.
#
# Toolchain: Zed editor, Go + gopls, Node 24 LTS + npm, bun, curl + gh
# (GitHub CLI), and the Pi coding agent CLI (npm global install).
# Workspace holds the demogit repo.
RUN set -eux; apt-get update; \
    apt-get install -y --no-install-recommends wget curl xz-utils git unzip gh \
        libvulkan1 mesa-vulkan-drivers libxkbcommon0 libasound2t64 golang-go \
        chromium vlc libdbus-glib-1-2; \
    #
    # Zed, matching the image architecture
    ARCH=$(dpkg --print-architecture); \
    case "${ARCH}" in \
        amd64) ZED_ARCH="x86_64"; BUN_ARCH="x64"; NODE_ARCH="x64" ;; \
        arm64) ZED_ARCH="aarch64"; BUN_ARCH="aarch64"; NODE_ARCH="arm64" ;; \
        *) echo "unsupported arch: ${ARCH}" >&2; exit 1 ;; \
    esac; \
    wget -O /tmp/zed.tar.gz "https://github.com/zed-industries/zed/releases/latest/download/zed-linux-${ZED_ARCH}.tar.gz"; \
    tar -xzf /tmp/zed.tar.gz -C /opt; \
    mv /opt/zed.app /opt/zed; \
    ln -sf /opt/zed/bin/zed /usr/local/bin/zed; \
    rm -f /tmp/zed.tar.gz; \
    #
    # Go toolchain + gopls (Zed's Go extension picks gopls from PATH)
    GOPROXY=https://goproxy.cn,direct GOBIN=/usr/local/bin go install golang.org/x/tools/gopls@latest; \
    #
    # bun runtime
    wget -O /tmp/bun.zip "https://github.com/oven-sh/bun/releases/latest/download/bun-linux-${BUN_ARCH}.zip"; \
    unzip -q /tmp/bun.zip -d /tmp; \
    install -m 0755 "/tmp/bun-linux-${BUN_ARCH}/bun" /usr/local/bin/bun; \
    rm -rf /tmp/bun.zip "/tmp/bun-linux-${BUN_ARCH}"; \
    #
    # Node 24 LTS (Debian trixie's nodejs is too old: pi requires >=22.19)
    NODE_TARBALL=$(wget -qO- https://nodejs.org/dist/latest-v24.x/ | grep -oE "node-v[0-9.]+-linux-${NODE_ARCH}\.tar\.xz" | head -1); \
    wget -O /tmp/node.tar.xz "https://nodejs.org/dist/latest-v24.x/${NODE_TARBALL}"; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1; \
    rm -f /tmp/node.tar.xz; \
    node --version; \
    npm --version; \
    #
    # Pi coding agent CLI (global npm install -> /usr/local/bin/pi)
    npm install -g @earendil-works/pi-coding-agent; \
    command -v pi; \
    #
    # workspace: demogit repo
    git clone --depth 1 https://github.com/java131313/demogit.git /home/neko/workspace/demogit; \
    #
    # Tor Browser: official per-arch tarball (torproject update API),
    # like the tor-browser app; the dir must belong to the runtime user
    case "${ARCH}" in \
        amd64) TOR_JSON="https://aus1.torproject.org/torbrowser/update_3/release/download-linux-x86_64.json" ;; \
        arm64) TOR_JSON="https://aus1.torproject.org/torbrowser/update_3/release/download-linux-aarch64.json" ;; \
        *) echo "unsupported arch: ${ARCH}" >&2; exit 1 ;; \
    esac; \
    TOR_URI=$(curl -s -N "$TOR_JSON" | grep -Po '"binary"\s*:\s*"\K[^"]+'); \
    curl -sSL -o /tmp/tor.tar.xz "$TOR_URI"; \
    tar -xJf /tmp/tor.tar.xz -C /opt; \
    mv /opt/tor-browser* /opt/tor-browser_en-US; \
    chown -R neko:neko /opt/tor-browser_en-US; \
    rm -f /tmp/tor.tar.xz; \
    #
    # default project directory
    mkdir -p /home/neko/workspace; \
    chown -R neko:neko /home/neko/workspace; \
    #
    # clean up
    apt-get clean -y; \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/*

#
# copy configuation files
COPY supervisord.rust.conf /etc/neko/supervisord/zed.conf
COPY openbox.xml /etc/neko/openbox.xml

# vlc's default media location (a bare UI when empty, like the vlc app)
ENV VLC_MEDIA="/media"
RUN mkdir -p /media && chown neko:neko /media
